{
  "description": "MoeProf deterministic never-event guard for Codex.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.moeprof/adapters/codex/hooks/policy_guard.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.moeprof\\adapters\\codex\\hooks\\policy_guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking MoeProf policy"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.moeprof/adapters/codex/hooks/policy_guard.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.moeprof\\adapters\\codex\\hooks\\policy_guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking MoeProf approval policy"
          }
        ]
      }
    ]
  }
}
